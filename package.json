{
  "name": "beat-exe",
  "private": true,
  "version": "0.2.0",
  "description": "BEAT.EXE — a cute hacker-terminal live coding music editor powered by Strudel",
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "lolizei",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:smoke": "npm run build && node tests/smoke/build.mjs && node tests/smoke/smoke.mjs && node tests/smoke/real.mjs && node tests/smoke/library.mjs && node tests/smoke/extensions.mjs && node tests/smoke/piano.mjs && node tests/smoke/worklets.mjs && node tests/smoke/samples.mjs",
    "test:worklets": "npm run build && node tests/smoke/worklets.mjs",
    "test:piano": "npm run build && node tests/smoke/piano.mjs",
    "test:audio": "npm run build && node tests/smoke/audio.mjs",
    "test:recording": "npm run build && node tests/smoke/recording.mjs",
    "test:feedback": "npm run build && node tests/smoke/tester-feedback.mjs",
    "test:note-preview": "npm run build && node tests/smoke/build.mjs && node tests/smoke/note-preview.mjs --calls && node tests/smoke/note-preview.mjs",
    "test:live-piano": "npm run build && node tests/smoke/live-piano.mjs",
    "test:beginner": "npm run build && node --import tsx tests/smoke/beginner.mjs",
    "test:terminal": "npm run build && node tests/smoke/terminal-animations.mjs",
    "test:library": "npm run build && node tests/smoke/library.mjs && node tests/smoke/extensions.mjs",
    "test:sonic-pi": "node --import tsx tests/smoke/sonic-pi.mjs",
    "test:endurance": "npm run build && node tests/smoke/endurance.mjs",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win zip --x64",
    "test:desktop": "node tests/smoke/desktop.mjs",
    "desktop:share": "npm run desktop:build && node scripts/desktop-release.mjs",
    "test:distribution": "node tests/smoke/distribution.mjs",
    "test:customization": "npm run build && node tests/smoke/build.mjs && node tests/smoke/customization.mjs --calls && node tests/smoke/customization.mjs",
    "steam:prepare": "node scripts/steam-prepare.mjs",
    "desktop:linux:build": "npm run build && electron-builder --linux --dir --x64 --config electron-builder-linux.cjs",
    "desktop:linux:share": "npm run desktop:linux:build && node scripts/linux-release.mjs",
    "test:linux:package": "node tests/smoke/linux-package.mjs",
    "steam:prepare:linux": "node scripts/steam-prepare-linux.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.0",
    "@strudel/web": "^1.2.0",
    "codemirror": "^6.0.1",
    "libflacjs": "5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
